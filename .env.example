# artha-engine environment template.
# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real values.

# ── Database ─────────────────────────────────────────────────
DB_URL=postgresql+psycopg2://artha:artha@localhost:5432/artha

# ── Statement PDF passwords (comma-separated), or the profile they are derived from ──
STATEMENT_PDF_PASSWORDS=
STATEMENT_HOLDER_NAME=
STATEMENT_DOB=
STATEMENT_MOBILE=
STATEMENT_PAN=
STATEMENT_PINCODE=

# ── Auth ─────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
COOKIE_SECURE=false                 # set true once served over HTTPS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173  # base for password-reset links

# ── Email (password-reset / invites). Gmail example below. ──
# Create a Gmail App Password (Google Account → Security → App passwords),
# NOT your normal password. Until these are set, reset links are written to
# /tmp/artha_reset_links.log so onboarding still works locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Artha <no-reply@artha.local>

# ── Gmail auto-pull (read-only scope) ──
# OAuth client credentials JSON downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=

# ── AI layer (optional). Unset = every AI feature falls back to the deterministic path. ──
ANTHROPIC_API_KEY=
# true routes the advisor through the tool-calling agent; false (default) uses the prompt-based path.
ADVISOR_GROUNDED=false

# ── Only needed when upgrading a database that already has users: which username becomes super admin.
# ARTHA_SUPER_ADMIN_USERNAME=
